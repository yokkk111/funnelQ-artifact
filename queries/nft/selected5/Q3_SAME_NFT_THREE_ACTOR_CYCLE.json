{
  "query_name": "Q3_SAME_NFT_THREE_ACTOR_CYCLE",
  "description": "A short-horizon cross-transaction three-actor cycle within 30 minutes in which the same NFT x moves A to B to C and back to A.",
  "full_binding_plan": {
    "query_id": "Q3_SAME_NFT_THREE_ACTOR_CYCLE",
    "result_semantics": "full_event_binding_v1",
    "delta_seconds": 1800,
    "branches": [
      {
        "branch_id": "same_nft_three_actor_cycle",
        "event_patterns": [
          {"id": "root", "event_type": "NFTTrade", "src": "$A", "dst": "$B", "nft": "$x", "collection": "$collection"},
          {"id": "middle", "event_type": "NFTTrade", "src": "$B", "dst": "$C", "nft": "$x", "collection": "$collection"},
          {"id": "back", "event_type": "NFTTrade", "src": "$C", "dst": "$A", "nft": "$x", "collection": "$collection"}
        ],
        "constraints": [
          {"type": "order", "sequence": ["root", "middle", "back"]},
          {"type": "strict_time_order", "sequence": ["root", "middle", "back"]},
          {"type": "within", "earlier": "root", "later": "back", "delta_seconds": 1800},
          {"type": "min_distinct", "values": ["$A", "$B", "$C"], "min_count": 3},
          {"type": "distinct_event_ids", "events": ["root", "middle", "back"]},
          {"type": "distinct_transactions", "events": ["root", "middle", "back"]}
        ]
      }
    ]
  },
  "result_semantics": "full_event_binding_v1"
}
