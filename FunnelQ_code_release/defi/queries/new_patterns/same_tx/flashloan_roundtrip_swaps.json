{
  "query_name": "flashloan_roundtrip_swaps",
  "scope": "same_tx",
  "events": [
    {"id": "e1", "type": "flashloan", "roles": {"recipient": "$u", "asset": "$x"}},
    {"id": "e2", "type": "swap", "roles": {"taker": "$u", "token_sold": "$x", "token_bought": "$y", "pool": "$p1"}},
    {"id": "e3", "type": "swap", "roles": {"taker": "$u", "token_sold": "$y", "token_bought": "$x", "pool": "$p2"}}
  ],
  "order": [["e1", "e2"], ["e2", "e3"]],
  "attr_filters": [],
  "neq_constraints": [["e2", "pool", "e3", "pool"]]
}
