{
  "query_name": "borrow_refinance_other_pool",
  "scope": "anchored_episode",
  "events": [
    {"id": "e1", "type": "borrow", "roles": {"borrower": "$u", "asset": "$x", "pool": "$p1"}},
    {"id": "e2", "type": "borrow", "roles": {"borrower": "$u", "asset": "$x", "pool": "$p2"}}
  ],
  "order": [["e1", "e2"]],
  "attr_filters": [
    {"event": "e1", "field": "amount", "op": ">", "value": "0"},
    {"event": "e2", "field": "amount", "op": "<", "value": "0"}
  ],
  "neq_constraints": [["e1", "pool", "e2", "pool"]],
  "scope_params": {"semantic_anchor_event": "e1", "execution_anchor_event": "auto", "forward_window_sec": 60}
}
