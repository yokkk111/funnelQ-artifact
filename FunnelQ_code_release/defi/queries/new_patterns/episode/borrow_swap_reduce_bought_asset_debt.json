{
  "query_name": "borrow_swap_reduce_bought_asset_debt_episode",
  "scope": "anchored_episode",
  "events": [
    {"id": "e1", "type": "borrow", "roles": {"borrower": "$u", "asset": "$x"}},
    {"id": "e2", "type": "swap", "roles": {"taker": "$u", "token_sold": "$x", "token_bought": "$y"}},
    {"id": "e3", "type": "borrow", "roles": {"borrower": "$u", "asset": "$y"}}
  ],
  "order": [["e1", "e2"], ["e2", "e3"]],
  "attr_filters": [
    {"event": "e1", "field": "amount", "op": ">", "value": "0"},
    {"event": "e3", "field": "amount", "op": "<", "value": "0"}
  ],
  "neq_constraints": [],
  "scope_params": {"semantic_anchor_event": "e1", "execution_anchor_event": "auto", "forward_window_sec": 60}
}
