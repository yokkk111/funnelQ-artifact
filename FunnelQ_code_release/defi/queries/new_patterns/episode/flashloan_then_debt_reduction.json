{
  "query_name": "flashloan_then_debt_reduction_episode",
  "scope": "anchored_episode",
  "events": [
    {"id": "e1", "type": "flashloan", "roles": {"recipient": "$u", "asset": "$x"}},
    {"id": "e2", "type": "borrow", "roles": {"borrower": "$u", "asset": "$x"}}
  ],
  "order": [["e1", "e2"]],
  "attr_filters": [{"event": "e2", "field": "amount", "op": "<", "value": "0"}],
  "neq_constraints": [],
  "scope_params": {"semantic_anchor_event": "e1", "execution_anchor_event": "auto", "forward_window_sec": 60}
}
